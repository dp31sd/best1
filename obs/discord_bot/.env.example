# ─── SuS Cracker Discord Bot Config (Örnek Şablon) ───
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Sunucu ID'si (sağ tık → Sunucu ID'sini kopyala)
GUILD_ID=0

# Kanal / Rol ID'leri (Gerekli değilse 0 bırakılabilir)
MOD_LOG_CHANNEL=0                         # Moderasyon logları kanalı
WELCOME_CHANNEL=0                         # Hoş geldin/güle güle kanalı
TICKET_CATEGORY=0                         # Ticket kanallarının kategorisi
TICKET_LOG=0                              # Ticket transkriptleri kanalı
VERIFY_ROLE=0                             # Doğrulama sonrası verilecek rol
AUTO_ROLE=0                               # Sunucuya katılınca otomatik verilecek rol
STARBOARD_CHANNEL=0                       # Starboard kanalı
STAR_THRESHOLD=3                          # Kaç ⭐ reaksiyon = Starboard'a ekle

# ─── Gelişmiş Motor & Sistem Ayarları ─────────────────
MAX_FILE_SIZE_MB=50                       # Maksimum kabul edilen dosya boyutu (MB)
ENGINE_TIMEOUT_SECONDS=180                # Java motoru zaman aşımı süresi (saniye)
MAX_CONCURRENT_TASKS=2                    # Aynı anda işlenebilecek maksimum ağır bytecode görevi
DEFAULT_DEOBF_ENGINE=auto                 # auto | vineflower | cfr
DEFAULT_OBF_PRESET=aggressive             # standard | aggressive | extreme
STATUS_ACTIVITY=⚡ /help | SuS Suite v4.0  # Bot Discord durum metni
BRAND_COLOR=0x9B59B6                      # Bot ana tema rengi (HEX)
LOG_LEVEL=INFO                            # INFO | DEBUG | WARN
